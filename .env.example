# Vercel Project > Settings > Environment Variables (Production + Preview).
# Use the same values for both services. Never prefix secrets with NEXT_PUBLIC_.
TQ_DEPLOYMENT=cloud
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Supabase Authentication > Users: UUID of each allowed GitHub user.
TQ_ALLOWED_USER_IDS=your-supabase-user-uuid,friend-supabase-user-uuid
TQ_APP_URL=https://your-project.vercel.app
# Supabase Connect > Transaction pooler; URL-encode password; sslmode=require.
DATABASE_URL=postgresql://postgres.your-project:your-password@your-pooler-host:6543/postgres?sslmode=require
# R2 token restricted to read-only for this private bucket in Vercel.
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=tradequest-market-data
R2_ACCESS_KEY_ID=your-read-only-access-key
R2_SECRET_ACCESS_KEY=your-read-only-secret
# TQ_API_URL is injected by the Vercel service binding. Do not set it manually.
