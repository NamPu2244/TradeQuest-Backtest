{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "bindings": [{"type": "service", "service": "api", "format": "url", "env": "TQ_API_URL"}]
    },
    "api": {
      "root": "apps/api/",
      "framework": "fastapi",
      "entrypoint": "index:app"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": {"service": "web"}}]
}
